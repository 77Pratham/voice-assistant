# Copy to .env and edit. Every value is optional; defaults are shown.
HOST=127.0.0.1
PORT=8000

# Speech-to-text (faster-whisper). "auto" = large-v3-turbo on CUDA, small on CPU.
WHISPER_MODEL=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=0   # 0 = auto (5 on GPU, 1 on CPU)

# Language model served by Ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=gemma3:4b
LLM_KEEP_ALIVE=30m
LLM_NUM_CTX=4096
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=220
MAX_HISTORY_MESSAGES=24

# Text-to-speech (Piper)
VOICE_EN=en_US-lessac-medium
VOICE_HI=hi_IN-pratham-medium
TTS_LENGTH_SCALE=1.0
TTS_USE_CUDA=false

# Debug: save every received utterance to logs/utterances/*.wav so you can listen to what Whisper hears
SAVE_UTTERANCES=false
